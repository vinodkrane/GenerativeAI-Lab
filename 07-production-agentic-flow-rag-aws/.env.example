# Copy to .env for `make run` (local backends, no AWS needed) and `make docker-up`.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO

# --- local secrets (dev only; production uses Cognito and S3 presigned POSTs) ---
RAG_LOCAL_JWT_SECRET=change-me-to-a-random-64-char-hex-string-000000000000000000000000
RAG_LOCAL_UPLOAD_SECRET=change-me-to-another-random-64-char-hex-string-00000000000000000

# --- backends: local | aws ---
RAG_OBJECT_STORE=local
RAG_QUEUE=local
RAG_SEARCH=memory
RAG_MODELS=local
RAG_AUTH_MODE=local
RAG_DATABASE_URL=sqlite:///./.data/rag.db
RAG_LOCAL_DATA_DIR=./.data
RAG_EMBEDDED_WORKER=true
RAG_EMBEDDING_DIMENSIONS=384
RAG_PUBLIC_BASE_URL=http://localhost:8000

# --- AWS (only when using AWS backends or Bedrock models) ---
# RAG_AWS_REGION=eu-west-2
# RAG_MODELS=bedrock
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_AGENT_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# RAG_GENERATOR_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# RAG_RERANK_MODEL_ARN=arn:aws:bedrock:eu-central-1::foundation-model/amazon.rerank-v1:0
# RAG_RERANK_REGION=eu-central-1

# --- limits (all optional; defaults in src/lean_rag/config.py) ---
# RAG_LIMITS__MAX_LLM_CALLS_PER_QUERY=4
# RAG_LIMITS__GENERATION_ATTEMPTS=2
# RAG_LIMITS__MAX_RECEIVE_COUNT=5
